# Never include local third-party validation material or generated inspection data
# in a broad initial commit/archive. Public releases must use the explicit manual
# allowlist in PUBLICATION_CHECKLIST.md.
/reference/
/cache/
/picking/
/picks/
/__pycache__/
/.pytest_cache/

# Working candidates are not approved release curves.
/manual/candidates/*
!/manual/candidates/README.md

# CT-derived QC screenshots stay local or in an organizer-approved channel
# unless Vesuvius Challenge gives written redistribution permission.
/manual/screenshots/*
!/manual/screenshots/README.md

# Exact-CT reviewer packs are generated locally from source volumes.
/audit/ct_review_local/
/audit/ct_review_cache/

# Local Python caches.
__pycache__/
*.pyc

# Reproduction commands may write machine-local scratch receipts. The pinned,
# validated results_*.json receipts remain tracked.
/audit/downstream/reproduced_*.json

# GPU fits, copied public inputs, caches, and CT review renders are generated
# locally by the downstream axis A/B harness. Only preregistration, code, and
# compact result receipts belong in git.
/downstream/spiral_axis_ab/work/

# Superseded before segment-keyed escalation receipts were introduced.
/audit/midpoint_density/*_level*_escalation.json
